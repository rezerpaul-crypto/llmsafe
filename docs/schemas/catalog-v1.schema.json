{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rezerpaul-crypto/llmsafe/blob/main/docs/schemas/catalog-v1.schema.json",
  "title": "LLMSafe rule catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "severity", "family", "description", "remediation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]+[0-9]{3}$"},
          "title": {"type": "string"},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "family": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "remediation": {"type": "string"}
        }
      }
    }
  }
}
