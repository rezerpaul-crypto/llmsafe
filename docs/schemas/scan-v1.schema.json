{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rezerpaul-crypto/llmsafe/blob/main/docs/schemas/scan-v1.schema.json",
  "title": "LLMSafe scan result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "summary", "findings", "errors"],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanned_files",
        "skipped_files",
        "findings",
        "baseline_findings",
        "errors"
      ],
      "properties": {
        "scanned_files": {"type": "integer", "minimum": 0},
        "skipped_files": {"type": "integer", "minimum": 0},
        "findings": {"type": "integer", "minimum": 0},
        "baseline_findings": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "errors": {
      "type": "array",
      "items": {"$ref": "#/$defs/error"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column", "message"],
      "properties": {
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1},
        "message": {"type": "string"},
        "path": {"type": "string"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "severity",
        "path",
        "line",
        "column",
        "message",
        "remediation",
        "evidence"
      ],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^[A-Z]+[0-9]{3}$"},
        "title": {"type": "string"},
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "path": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1},
        "message": {"type": "string"},
        "remediation": {"type": "string"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "message"],
      "properties": {
        "path": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
}
